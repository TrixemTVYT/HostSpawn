# HostSpawn secrets. Copy to config/secrets.env, chmod 600. Never commit the real file.
# ./manager.sh init-secrets creates it with fresh random values for you (and never prints them).

# Dashboard login (user: admin)
MANAGER_PASSWORD=

# Arma 3 (filled by backend/games/arma3/install.sh / init-secrets)
ARMA3_STEAM_USER=
ARMA3_ADMIN_PASSWORD=
ARMA3_SERVER_PASSWORD=

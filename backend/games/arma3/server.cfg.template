// $community Arma 3 (basic, vanilla). Generated by Manager at every start from
// backend/games/arma3/server.cfg.template - edit the template (or servers.toml), not the generated file.
// Passwords come from config/secrets.env and are never stored in this template.
hostname = "$hostname";
password = "$password";
passwordAdmin = "$password_admin";
maxPlayers = $max_players;
motd[] = {"Welcome to $community"};
motdInterval = 5;

persistent = $persistent;  // 1 when a mission is set: it starts with the server (-autoInit) and keeps running
voteThreshold = 0.33;
disableVoN = 0;
vonCodec = 1;
vonCodecQuality = 20;

BattlEye = $battleye;  // 1 = on (default); 0 = off, set in HostSpawn's Settings tab
verifySignatures = 2;
kickDuplicate = 1;
allowedFilePatching = 0;

timeStampFormat = "short";
logFile = "server_console.log";

$missions
